# ---- Server ----
PORT=3000
# Path to the SQLite database file
DB_PATH=./data/crm.db

# ---- Dashboard login (HTTP Basic Auth). Leave empty only for local testing! ----
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# ---- WhatsApp Cloud API (Meta) ----
# Leave WHATSAPP_TOKEN empty to run in MOCK mode (nothing is sent to WhatsApp).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any random string; paste the same value into the Meta webhook settings
WHATSAPP_VERIFY_TOKEN=my-verify-token
# App secret from Meta > App settings > Basic. Used to verify webhook signatures.
WHATSAPP_APP_SECRET=
# Meta retires each version ~2 years after release; check developers.facebook.com/docs/graph-api/changelog
GRAPH_API_VERSION=v26.0

# How often the follow-up scheduler checks for due messages (seconds)
SCHEDULER_INTERVAL_SECONDS=30
